/* ==========================================================================
   The leave screen
   ==========================================================================
   A scrolling year on the left, three panels on the right. The panels are the
   answer to a screen with more direct actions than the key strip can carry:
   the wallet says what you can afford, the selection says what you are about
   to act on, and the legend says which key does it.
   ========================================================================== */

#leave-body {
    height: 1fr;
    padding: 0 1;
}

/* The calendar takes everything the rail does not need. Days are tiles that
   share the full width, so there is no leftover to look wrong however wide the
   terminal is. */
#leave-calendar {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#leave-rail {
    width: 34;
    height: 1fr;
    padding: 0 0 0 1;
}

#leave-wallet-line {
    display: none;
    height: 1;
}

#leave-wallet,
#leave-selection,
#leave-legend {
    height: auto;
    margin: 0;
}

#leave-wallet Gauge {
    margin: 0;
}

#leave-selection-label {
    height: 1;
}

#leave-selection-detail,
#leave-selection-booked {
    height: 1;
}

#leave-legend-body {
    height: auto;
}

/* Under 100 columns the rail's 36 cells leave the calendar 28 — four days of a
   week. The rail goes, the wallet becomes one line above the grid, and the
   legend moves to `?` where it was always also available. */
LeaveScreen.-narrow #leave-body {
    layout: vertical;
}

LeaveScreen.-narrow #leave-calendar {
    width: 1fr;
}

/* Two lines, not three panels. Every row the rail keeps is a row of calendar
   somebody cannot see, and on a narrow terminal that is the whole screen. */
LeaveScreen.-narrow #leave-rail {
    width: 1fr;
    height: 2;
    padding: 0;
}

LeaveScreen.-narrow #leave-selection {
    border: none;
    height: 1;
    padding: 0;
}

LeaveScreen.-narrow #leave-selection-label {
    display: none;
}

LeaveScreen.-narrow #leave-selection-detail {
    display: none;
}

LeaveScreen.-narrow #leave-wallet,
LeaveScreen.-narrow #leave-legend {
    display: none;
}

LeaveScreen.-narrow #leave-wallet-line {
    display: block;
}

LeaveScreen.-narrow #leave-selection {
    height: auto;
}

/* Under 64, the selection panel goes too. The status bar already reports every
   write, and the cursor is visible on the grid. */
LeaveScreen.-tiny #leave-selection {
    display: none;
}


/* -- the grid -------------------------------------------------------------
   Every tile paints its own ground. A booked day takes a deep wash of its
   type's colour with the lift on top, which is legible at a glance and still
   quiet enough that a month of annual leave does not shout down the cursor.
   ------------------------------------------------------------------------- */

YearCalendar {
    background: $c-ink;
}

YearCalendar > .cal--month {
    color: $c-muted;
    background: $c-ink;
    text-style: bold;
}

YearCalendar > .cal--weekday {
    color: $c-ash;
    background: $c-ink;
    text-style: bold;
}

YearCalendar > .cal--day {
    color: $c-paper;
    background: $c-ink;
}

/* The blanks at a seam. Painted, not left to whatever the widget's ground is. */
YearCalendar > .cal--empty {
    background: $c-ink;
}

/* Dim, not washed. Two shaded columns running the length of a year is the
   heaviest thing on the screen, and it is the least important: a dim number
   already says the day is not yours to book. */
YearCalendar > .cal--weekend {
    color: $c-line;
    background: $c-ink;
}

YearCalendar > .cal--outside {
    color: $c-line;
    background: $c-ink;
}

/* Today is underlined rather than coloured: it can coincide with a booking, a
   weekend and the selection, and a fourth colour on one tile makes all four
   unreadable. */
YearCalendar > .cal--today {
    text-style: bold underline;
}

YearCalendar > .cal--cursor {
    background: $c-accent;
    color: $c-ink;
    text-style: bold;
}

YearCalendar > .cal--selected {
    background: $c-accent-deep;
    color: $c-accent-lift;
}

YearCalendar > .cal--holiday {
    color: $c-holiday-lift;
    background: $c-holiday-deep;
}

YearCalendar > .cal--annual {
    color: $c-annual-lift;
    background: $c-annual-deep;
}

YearCalendar > .cal--sick {
    color: $c-sick-lift;
    background: $c-sick-deep;
}

YearCalendar > .cal--toil {
    color: $c-toil-lift;
    background: $c-toil-deep;
}

YearCalendar > .cal--unpaid {
    color: $c-unpaid-lift;
    background: $c-unpaid-deep;
}

YearCalendar > .cal--other {
    color: $c-other-lift;
    background: $c-other-deep;
}
